{
  "name": "quarryvault-backend",
  "version": "1.0.0",
  "description": "QuarryVault Node.js + Express + TypeScript Backend with MongoDB and Cloudflare R2",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "diagnose:auth": "tsx src/scripts/diagnoseAuth.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrapAdmin.ts",
    "migrate": "tsx src/scripts/migrateFromSql.ts",
    "purge": "tsx src/scripts/purgeExpiredDocuments.ts",
    "backfill:folders": "tsx src/scripts/backfillStandardFolders.ts",
    "backup:dr": "tsx src/scripts/disasterRecovery.ts",
    "permissions:conflicts": "tsx src/scripts/reportPermissionConflicts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "tar-stream": "3.2.2",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
