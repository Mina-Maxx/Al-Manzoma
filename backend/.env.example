# QuarryVault Backend Environment Configuration
# Node.js + Express + TypeScript + MongoDB + Cloudflare R2
# Copy this file to .env and fill in real values.
# NEVER commit a populated .env file with secrets.

NODE_ENV=development
PORT=8000

# MongoDB Connection URL
MONGODB_URI=mongodb://localhost:27017/quarryvault

# JWT Authentication (Local development & fallback)
JWT_SECRET=replace-with-at-least-32-characters-random-secret
JWT_ISSUER=quarryvault-dev
JWT_AUDIENCE=quarryvault-dev

# Supabase Auth Integration (Optional / Pilot)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ALGORITHMS=RS256,ES256

# Dashboard Base URL (Used for auth redirects)
DASHBOARD_BASE_URL=http://localhost:8000

# HMAC Key for Signed Sync Feed Cursors (Minimum 32 characters)
SYNC_CURSOR_SECRET=replace-with-at-least-32-characters-sync-secret

# Upload Limits & Quotas
MAX_FILE_SIZE_BYTES=10485760
DEFAULT_COMPANY_QUOTA_BYTES=5368709120
DEFAULT_COMPANY_MAX_USERS=10
IDEMPOTENCY_LEASE_SECONDS=300
INVITE_RATE_LIMIT_PER_MINUTE=10

# Storage Provider: "r2", "s3", or "local" (for tests/offline dev)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./.storage

# Cloudflare R2 (Required when STORAGE_BACKEND=r2 or s3)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=quarryvault-docs
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto

# Web & CORS Origin
WEB_ORIGIN=http://localhost:3001
