# QuarryVault backend configuration. Copy to .env and fill in real values.
# NEVER commit a populated .env file.

APP_ENV=development

# PostgreSQL (runtime). Tests use TEST_DATABASE_URL instead.
DATABASE_URL=postgresql+psycopg://quarryvault:quarryvault@localhost:5432/quarryvault

# Set by the test suite only. Used to create the schema (Alembic) and run tests.
TEST_DATABASE_URL=postgresql+psycopg://quarryvault:quarryvault@localhost:55432/quarryvault_test

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=RS256,ES256
JWKS_CACHE_TTL_SECONDS=3600
JWKS_TIMEOUT_SECONDS=10

# Backend-only. Required for employee invitations (Supabase Admin API).
# NEVER expose this to clients or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# PUBLIC anon key, served to the browser for the dashboard's Supabase Auth calls.
# Safe to expose ONLY because the DB is never queried with it (no RLS data path).
SUPABASE_ANON_KEY=

# Public base URL of this backend+dashboard; used to build auth email redirects.
DASHBOARD_BASE_URL=http://localhost:8000

# HMAC key for signed sync-feed cursors. Required for GET /sync/changes; the
# production value must be a stable random string of at least 32 characters.
# Rotating it invalidates existing cursors (clients must bootstrap again).
# NEVER expose this key to clients or commit a populated .env file.
SYNC_CURSOR_SECRET=

# Upload limits and company defaults
MAX_FILE_SIZE_BYTES=10485760
DEFAULT_COMPANY_QUOTA_BYTES=5368709120
DEFAULT_COMPANY_MAX_USERS=10

# Storage: "local" (tests only) or "gdrive" (pilot)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./.storage

# Google Drive (only when STORAGE_BACKEND=gdrive)
GDRIVE_ROOT_FOLDER_NAME=QuarryVault
GDRIVE_ROOT_FOLDER_ID=
# Path to the authorized-user credentials file produced by scripts/gdrive_oauth.py
GDRIVE_CREDENTIALS_FILE=
GOOGLE_RETRY_MAX_ATTEMPTS=5
GOOGLE_RETRY_BASE_SECONDS=0.5

# Local development auth ONLY. Never active unless APP_ENV=development is set
# explicitly, and always disabled when APP_ENV=production.
# When DEV_AUTH_ENABLED=true you MUST change DEV_JWT_SECRET to a random value of
# at least 32 characters; the placeholder below is rejected by design.
DEV_AUTH_ENABLED=false
DEV_JWT_SECRET=dev-insecure-secret-change-me
DEV_JWT_ISSUER=quarryvault-dev
DEV_JWT_AUDIENCE=quarryvault-dev
