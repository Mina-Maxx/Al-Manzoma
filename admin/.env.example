# QuarryVault Admin Dashboard Environment Configuration
# Copy this file to .env.local to customize local development settings.

# Backend API URL:
# - Leave empty (default) to route API calls through Next.js same-origin rewrites to http://localhost:8000.
# - Or set explicitly to http://localhost:8000 if making direct cross-origin browser requests.
NEXT_PUBLIC_API_URL=

# Port for Next.js development server (default: 3001)
PORT=3001
